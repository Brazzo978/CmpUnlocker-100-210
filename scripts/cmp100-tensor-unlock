#!/usr/bin/env bash
# SPDX-License-Identifier: GPL-2.0-only
set -Eeuo pipefail

STATE_DIR=${CMP100_STATE_DIR:-/var/lib/cmp100-unlocker}
LIB_DIR=${CMP100_LIB_DIR:-/usr/lib/cmp100-unlocker}
MANIFEST=$STATE_DIR/manifest.env
FW_FECS=/lib/firmware/nvidia/gv100/gr/fecs_sig.bin
FW_BL=/lib/firmware/nvidia/gv100/acr/bl.bin
FW_UCODE=/lib/firmware/nvidia/gv100/acr/ucode_load.bin
STOCK_FECS=$STATE_DIR/stock/fecs_sig.bin
STOCK_BL=$STATE_DIR/stock/bl.bin
STOCK_UCODE=$STATE_DIR/stock/ucode_load.bin
CUSTOM_FECS=$LIB_DIR/payloads/fecs_sig.candidate-c-504.bin
CUSTOM_BL=$LIB_DIR/payloads/bl.load-candidate-c.bin
CUSTOM_UCODE=$LIB_DIR/payloads/ucode_load.tensor-success-lsb-restore.bin
HOOK=$LIB_DIR/gv100_nouveau_acr_hook.ko
LOGDIR=/var/log/cmp100-tensor-unlock
LOG=$LOGDIR/run-$(date -u +%Y%m%dT%H%M%SZ).log
PERSISTENCED_WAS_ACTIVE=0
SUCCESS=0
TARGETS=()

mkdir -p "$LOGDIR"
exec > >(tee -a "$LOG") 2>&1

say() { printf '[%s] %s\n' "$(date -u +%FT%TZ)" "$*"; }
die() { say "ERROR: $*"; exit 1; }
sha_of() { sha256sum "$1" | awk '{print $1}'; }
assert_sha() {
    local path=$1 expected=$2
    [[ -f $path ]] || die "missing $path"
    [[ $(sha_of "$path") == "$expected" ]] || die "SHA mismatch: $path"
}
driver_of() {
    local link
    link=$(readlink "/sys/bus/pci/devices/$1/driver" 2>/dev/null || true)
    printf '%s' "${link##*/}"
}
wait_nvidia_bdf() {
    local bdf_short=${1#0000:}
    local inventory
    local attempt
    for attempt in $(seq 1 20); do
        inventory=$(timeout 15 nvidia-smi --query-gpu=pci.bus_id,name --format=csv,noheader 2>/dev/null || true)
        if grep -Fqi "$bdf_short" <<< "$inventory"; then
            return 0
        fi
        sleep 0.5
    done
    return 1
}
restore_stock() {
    cp -f "$STOCK_FECS" "$FW_FECS"
    cp -f "$STOCK_BL" "$FW_BL"
    cp -f "$STOCK_UCODE" "$FW_UCODE"
    sync
}
remove_hook() {
    if [[ -d /sys/module/gv100_nouveau_acr_hook ]]; then
        rmmod gv100_nouveau_acr_hook
    fi
}
best_effort_nvidia_recovery() {
    local bdf current
    for bdf in "${TARGETS[@]}"; do
        current=$(driver_of "$bdf")
        if [[ $current == nouveau ]]; then
            printf 'test-hold' > "/sys/bus/pci/devices/$bdf/driver_override" || true
            printf '%s' "$bdf" > /sys/bus/pci/drivers/nouveau/unbind || true
            current=$(driver_of "$bdf")
        fi
        if [[ -z $current ]]; then
            printf 'nvidia' > "/sys/bus/pci/devices/$bdf/driver_override" || true
            printf '%s' "$bdf" > /sys/bus/pci/drivers/nvidia/bind || true
        fi
    done
    modprobe nvidia_uvm 2>/dev/null || true
}
cleanup() {
    local rc=$?
    trap - EXIT
    restore_stock || true
    remove_hook || true
    if (( SUCCESS == 0 )); then
        best_effort_nvidia_recovery || true
    fi
    if (( PERSISTENCED_WAS_ACTIVE )); then
        systemctl start nvidia-persistenced 2>/dev/null || true
    fi
    if (( rc != 0 )); then
        say "FAILED (rc=$rc); stock firmware restored. Inspect $LOG"
    fi
    exit "$rc"
}
trap cleanup EXIT

[[ $EUID -eq 0 ]] || die 'run as root'
[[ -r $MANIFEST ]] || die "missing $MANIFEST; run install.sh"
# The manifest is root-owned and contains only hashes generated by install.sh.
# shellcheck disable=SC1090
source "$MANIFEST"

if [[ -n ${CMP100_BDFS:-} ]]; then
    read -r -a TARGETS <<< "$CMP100_BDFS"
else
    for devdir in /sys/bus/pci/devices/0000:*; do
        [[ -r $devdir/vendor && -r $devdir/device ]] || continue
        if [[ $(<"$devdir/vendor") == 0x10de && $(<"$devdir/device") == 0x1d84 ]]; then
            TARGETS+=("${devdir##*/}")
        fi
    done
fi
(( ${#TARGETS[@]} > 0 )) || die 'no CMP100-210 (10de:1d84) found in PCI domain 0000'

assert_sha "$STOCK_FECS" "$STOCK_FECS_SHA"
assert_sha "$STOCK_BL" "$STOCK_BL_SHA"
assert_sha "$STOCK_UCODE" "$STOCK_UCODE_SHA"
assert_sha "$CUSTOM_FECS" "$CUSTOM_FECS_SHA"
assert_sha "$CUSTOM_BL" "$CUSTOM_BL_SHA"
assert_sha "$CUSTOM_UCODE" "$CUSTOM_UCODE_SHA"
assert_sha "$HOOK" "$HOOK_SHA"
restore_stock

for bdf in "${TARGETS[@]}"; do
    [[ $bdf =~ ^0000:[0-9a-fA-F]{2}:00\.0$ ]] || die "unsupported BDF shape: $bdf"
    [[ -d /sys/bus/pci/devices/$bdf ]] || die "missing PCI device $bdf"
    [[ $(<"/sys/bus/pci/devices/$bdf/vendor") == 0x10de ]] || die "$bdf vendor mismatch"
    [[ $(<"/sys/bus/pci/devices/$bdf/device") == 0x1d84 ]] || die "$bdf device mismatch"
    [[ $(driver_of "$bdf") == nvidia ]] || die "$bdf must start bound to nvidia"
done

if [[ -n ${CMP100_STOP_SERVICES:-} ]]; then
    for unit in $CMP100_STOP_SERVICES; do
        say "Stopping configured workload service $unit"
        systemctl stop "$unit"
    done
fi

if systemctl is-active --quiet nvidia-persistenced 2>/dev/null; then
    PERSISTENCED_WAS_ACTIVE=1
fi
systemctl stop nvidia-persistenced 2>/dev/null || true
for module in nvidia_uvm nvidia_drm nvidia_modeset; do
    if grep -q "^${module} " /proc/modules; then
        modprobe -r "$module" || die "cannot unload $module; stop GPU clients first"
    fi
done
modprobe nouveau

unlock_one() {
    local bdf=$1 bus_hex bus_dec devdir bar0 tensor_phys baseline
    local before_count after_count boot_line bdf_short attempt
    bus_hex=${bdf#0000:}
    bus_hex=${bus_hex%%:*}
    bus_dec=$((16#$bus_hex))
    bdf_short=${bdf#0000:}
    devdir=/sys/bus/pci/devices/$bdf
    bar0=$(awk 'NR==1 {print $1}' "$devdir/resource")
    tensor_phys=$(printf '0x%x' "$((bar0 + 0x409664))")

    say "$bdf: unbind NVIDIA"
    printf 'test-hold' > "$devdir/driver_override"
    printf '%s' "$bdf" > /sys/bus/pci/drivers/nvidia/unbind
    baseline=$(busybox devmem "$tensor_phys" 32)
    say "$bdf: Tensor baseline $baseline"
    if [[ $baseline == 0x00000888 ]]; then
        say "$bdf: already unlocked; return directly to NVIDIA"
        printf 'nvidia' > "$devdir/driver_override"
        printf '%s' "$bdf" > /sys/bus/pci/drivers/nvidia/bind
        wait_nvidia_bdf "$bdf" || die "$bdf absent from nvidia-smi after handoff"
        return 0
    fi
    [[ $baseline == 0x00000999 ]] || die "$bdf unexpected Tensor baseline $baseline"

    remove_hook
    insmod "$HOOK" bus="$bus_dec" armed=1 replace_on_return=2 load_test_size=0x5d00
    before_count=$(dmesg | grep -c 'gv100_nouveau_acr_hook: BOOT_RETURN' || true)

    cp -f "$CUSTOM_FECS" "$FW_FECS"
    cp -f "$CUSTOM_BL" "$FW_BL"
    cp -f "$CUSTOM_UCODE" "$FW_UCODE"
    sync

    say "$bdf: boot signed ACR chain through Nouveau"
    printf 'nouveau' > "$devdir/driver_override"
    printf '%s' "$bdf" > /sys/bus/pci/drivers/nouveau/bind

    for attempt in $(seq 1 50); do
        [[ $(driver_of "$bdf") == nouveau ]] && break
        sleep 0.1
    done
    [[ $(driver_of "$bdf") == nouveau ]] || die "$bdf did not bind to Nouveau"
    after_count=$(dmesg | grep -c 'gv100_nouveau_acr_hook: BOOT_RETURN' || true)
    (( after_count > before_count )) || die "$bdf produced no new BOOT_RETURN"
    boot_line=$(dmesg | grep 'gv100_nouveau_acr_hook: BOOT_RETURN' | tail -n 1)
    say "$bdf: $boot_line"
    [[ $boot_line == *'function_rc=0'* ]] || die "$bdf ACR return was not successful"
    [[ $boot_line == *'tensor_409664=0x00000888'* ]] || die "$bdf Tensor register was not unlocked"

    restore_stock
    remove_hook

    say "$bdf: clean Nouveau unload and NVIDIA handoff"
    printf 'test-hold' > "$devdir/driver_override"
    printf '%s' "$bdf" > /sys/bus/pci/drivers/nouveau/unbind
    [[ $(busybox devmem "$tensor_phys" 32) == 0x00000888 ]] || die "$bdf lost Tensor value before NVIDIA bind"
    printf 'nvidia' > "$devdir/driver_override"
    printf '%s' "$bdf" > /sys/bus/pci/drivers/nvidia/bind
    for attempt in $(seq 1 50); do
        [[ $(driver_of "$bdf") == nvidia ]] && break
        sleep 0.1
    done
    [[ $(driver_of "$bdf") == nvidia ]] || die "$bdf did not return to NVIDIA"
    wait_nvidia_bdf "$bdf" || die "$bdf absent from nvidia-smi after handoff"
    say "$bdf: unlock and NVIDIA handoff PASS"
}

for bdf in "${TARGETS[@]}"; do
    unlock_one "$bdf"
done

modprobe nvidia_uvm
restore_stock
remove_hook
SUCCESS=1

say 'All selected GPUs unlocked. Final inventory:'
nvidia-smi --query-gpu=index,pci.bus_id,name,driver_version,pcie.link.gen.current,pcie.link.gen.max --format=csv,noheader
say "PASS; log saved to $LOG"
